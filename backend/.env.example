# PostgreSQL, shared with Duet; Message Center uses mc_* tables.
DATABASE_URL=postgresql+psycopg://localhost/twinteams
REDIS_URL=redis://127.0.0.1:6379/0
DUET_BASE_URL=http://127.0.0.1:8000
MESSAGE_CENTER_SERVICE_TOKEN=
COOKIE_SECURE=false
# Optional: install `uv sync --extra enrichment`, configure the Runtime provider,
# and set this true only when model calls are authorized.
MESSAGE_CENTER_ENRICHMENT_ENABLED=false
# Maximum background reconciliation interval, clamped to 30–60 seconds.
MESSAGE_CENTER_RECONCILE_SECONDS=45
